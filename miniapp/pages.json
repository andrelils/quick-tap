{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "晓居智能",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/merchant/detail",
      "style": {
        "navigationBarTitleText": "商家详情",
        "navigationBarBackgroundColor": "#ffffff"
      }
    },
    {
      "path": "pages/user/register-bind",
      "style": {
        "navigationBarTitleText": "一键注册绑定"
      }
    },
    {
      "path": "pages/user/mine",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/promotion/jump",
      "style": {
        "navigationBarTitleText": "跳转到平台"
      }
    },
    {
      "path": "pages/wifi/index",
      "style": {
        "navigationBarTitleText": "WiFi连接"
      }
    },
    {
      "path": "pages/coupon/list",
      "style": {
        "navigationBarTitleText": "优惠券"
      }
    },
    {
      "path": "pages/scan/scan",
      "style": {
        "navigationBarTitleText": "扫码"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "晓居智能",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f6fa"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#1677ff",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/user/mine",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  }
}
