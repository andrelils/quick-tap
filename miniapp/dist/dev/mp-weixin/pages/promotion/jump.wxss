.promotion-jump.data-v-2d310800 {
  min-height: 100vh;
  background: linear-gradient(180deg, #e6f4ff 0%, #f5f6fa 30%);
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.jump-header.data-v-2d310800 {
  text-align: center;
  margin-bottom: 60rpx;
}
.platform-icon.data-v-2d310800 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.icon-text.data-v-2d310800 {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
}
.platform-name.data-v-2d310800 {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f1f1f;
  display: block;
}
.jump-desc.data-v-2d310800 {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-top: 16rpx;
  display: block;
}
.action-section.data-v-2d310800 {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.action-btn.data-v-2d310800 {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn.primary.data-v-2d310800 {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
}
.action-btn.secondary.data-v-2d310800 {
  background: #ffffff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
}
.link-box.data-v-2d310800 {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.link-label.data-v-2d310800 {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
  display: block;
}
.link-url.data-v-2d310800 {
  font-size: 26rpx;
  color: #595959;
  word-break: break-all;
  line-height: 1.5;
}
.tips-section.data-v-2d310800 {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.tip-title.data-v-2d310800 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #1f1f1f;
  margin-bottom: 24rpx;
}
.tip-icon.data-v-2d310800 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  font-style: italic;
}
.tip-list.data-v-2d310800 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}