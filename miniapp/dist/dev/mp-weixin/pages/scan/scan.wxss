.scan-page.data-v-933ff6b6 {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}
.scan-header.data-v-933ff6b6 {
  padding: 20rpx 30rpx;
  background: #000;
}
.scan-title.data-v-933ff6b6 {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}
.scan-content.data-v-933ff6b6 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scan-area.data-v-933ff6b6 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48rpx;
}
.scan-box.data-v-933ff6b6 {
  width: 500rpx;
  height: 500rpx;
  position: relative;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
}
.scan-line.data-v-933ff6b6 {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #1677ff, transparent);
  animation: scan-933ff6b6 2s ease-in-out infinite;
}
@keyframes scan-933ff6b6 {
0%, 100% {
    transform: translateY(-100rpx);
}
50% {
    transform: translateY(100rpx);
}
}
.scan-corner.data-v-933ff6b6 {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #1677ff;
  border-style: solid;
  border-width: 0;
}
.top-left.data-v-933ff6b6 {
  top: -2rpx;
  left: -2rpx;
  border-top-width: 6rpx;
  border-left-width: 6rpx;
  border-top-left-radius: 16rpx;
}
.top-right.data-v-933ff6b6 {
  top: -2rpx;
  right: -2rpx;
  border-top-width: 6rpx;
  border-right-width: 6rpx;
  border-top-right-radius: 16rpx;
}
.bottom-left.data-v-933ff6b6 {
  bottom: -2rpx;
  left: -2rpx;
  border-bottom-width: 6rpx;
  border-left-width: 6rpx;
  border-bottom-left-radius: 16rpx;
