.wifi-page.data-v-1bdb54f9 {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
}
.wifi-card.data-v-1bdb54f9 {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.wifi-icon-wrapper.data-v-1bdb54f9 {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wifi-icon.data-v-1bdb54f9 {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.wifi-wave.data-v-1bdb54f9 {
  position: absolute;
  border-radius: 50%;
  border: 4rpx solid #b7eb8f;
  animation: wifiPulse-1bdb54f9 2s ease-out infinite;
}
.wave1.data-v-1bdb54f9 {
  width: 120rpx;
  height: 120rpx;
  animation-delay: 0s;
}
.wave2.data-v-1bdb54f9 {
  width: 160rpx;
  height: 160rpx;
  animation-delay: 0.6s;
}
.wave3.data-v-1bdb54f9 {
  width: 200rpx;
  height: 200rpx;
  animation-delay: 1.2s;
}
@keyframes wifiPulse-1bdb54f9 {
0% {
    transform: scale(0.8);
    opacity: 0.8;
}
100% {
    transform: scale(1.2);
    opacity: 0;
}
}
.wifi-title.data-v-1bdb54f9 {
