# ============================================
# QuickTap Server 环境配置文件示例
# ============================================
# 使用方式：
# 1. 复制本文件为 .env（开发）或 .env.prod（生产）
# 2. 根据需要修改对应的值
# 3. 在 docker-compose 中会自动加载这些变量
# ============================================

# ============================================
# 数据库配置（生产环境：127.0.0.1:3306 / andre_sql / andre_sql）
# ============================================
# 数据库主机地址
# - Docker Compose 内部 MySQL：DB_HOST=mysql
# - 宿主机已有 MySQL：DB_HOST=127.0.0.1（或 host.docker.internal）
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库名
DB_NAME=andre_sql
# 数据库用户名（兼容 DB_USER / DB_USERNAME 两个键）
DB_USER=andre_sql
DB_USERNAME=andre_sql
# 数据库密码（生产环境必填）
DB_PASSWORD=lls_970401
# Hikari 连接池上限（对应 MySQL 用户 DB_CONNECTION_LIMIT=10）
DB_CONNECTION_LIMIT=10
DB_CONNECTION_MIN_IDLE=3

# ============================================
# Redis 配置（总开关：REDIS_ENABLED）
# 生产环境推荐 true，集群多实例共享缓存 + Token 黑名单
# 本地开发推荐 false，走 JVM 本地缓存，无需额外起 Redis
# ============================================
REDIS_ENABLED=true
# Redis 连接地址
# - Docker Compose 内部容器：REDIS_HOST=redis
# - 宿主机 Redis：REDIS_HOST=127.0.0.1（jar 包运行）或 host.docker.internal（容器运行）
# - 独立 Redis：REDIS_HOST=192.168.x.x
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 密码（生产环境已设置）
REDIS_PASSWORD=lls_970401
# 选择的 DB 编号（0~15，默认 0）
REDIS_DATABASE=0
# 读写 + 连接超时（毫秒）
REDIS_TIMEOUT=3000
REDIS_CONNECT_TIMEOUT=2000
# Lettuce 连接池
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=4
# 容器化 Redis 可用内存上限（仅 docker-compose 的 redis 容器使用）
REDIS_MAXMEMORY=512mb

# ============================================
# JWT 配置（必填）
# ============================================
# JWT Secret Key - 生产环境必须修改为安全的值！
# 生成方法：openssl rand -base64 48
# 要求：长度至少 64 字节（512 位），用于 HS512 算法
JWT_SECRET=your_strong_jwt_secret_key_in_production_must_be_changed_min_64_bytes_length

# ============================================
# 加密密钥配置（必填）
# ============================================
# 用于敏感数据加密的 AES-256 密钥（Base64 编码的 32 字节）
# 生成方法：openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_32_byte_encryption_key_here

# ============================================
# CORS 配置（生产环境服务器 IP: http://154.8.138.48）
# ============================================
# 允许的前端源，多个用逗号分隔
ALLOWED_ORIGINS=http://154.8.138.48,http://154.8.138.48:8080,http://154.8.138.48:8222

# ============================================
# Kafka 配置（可选）
# ============================================
# Kafka Bootstrap Servers
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ============================================
# Seata 分布式事务配置（支付业务必需）
# ============================================
# Seata Server (TC) 地址
# - Docker Compose 部署：SEATA_SERVER_ADDR=seata-server:8091
# - 独立部署：SEATA_SERVER_ADDR=127.0.0.1:8091
SEATA_SERVER_ADDR=seata-server:8091
# 开发环境是否启用 Seata（生产环境始终启用，开发环境默认关闭）
# 支付联调时设置为 true
SEATA_ENABLED=false
